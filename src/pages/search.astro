---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base title="Search" description="Search the FEDERG website." noindex>
  <PageHeader eyebrow="Search" title="Search the site" crumbs={[{ label: 'Search', href: '/search/' }]} />
  <section class="section section--white">
    <div class="container--narrow">
      <div id="search" class="search" data-search>
        <noscript><p class="lead">Search needs JavaScript. You can browse <a href="/news/">news</a> and <a href="/events/">events</a> instead.</p></noscript>
      </div>
      <p class="hint" data-search-hint hidden>
        The search index is generated by <code>npm run build</code>. Run <code>npm run build &amp;&amp; npm run preview</code> to try it locally.
      </p>
    </div>
  </section>
</Base>

<style>
  .search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #1f1f3f;
    --pagefind-ui-text: #15152b;
    --pagefind-ui-background: #fff;
    --pagefind-ui-border: #d8d6cf;
    --pagefind-ui-tag: #fff1e8;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-font: var(--font);
    min-height: 40vh;
  }

  .hint {
    margin-top: 1.5rem;
    color: var(--ink-soft);
  }

  code {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--paper);
    font-size: 0.9em;
  }
</style>

<script>
  // Pagefind builds a static index of the site after `astro build`, so search needs no server.
  const css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = '/pagefind/pagefind-ui.css';
  const script = document.createElement('script');
  script.src = '/pagefind/pagefind-ui.js';
  script.onload = () => {
    css.isConnected || document.head.append(css);
    const PagefindUI = (window as unknown as { PagefindUI: new (opts: object) => unknown }).PagefindUI;
    new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
  };
  script.onerror = () => {
    document.querySelector<HTMLElement>('[data-search-hint]')!.hidden = false;
  };
  document.head.append(css, script);
</script>
