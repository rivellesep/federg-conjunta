---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const links = await getCollection('links');
const groups = Map.groupBy(links, (l) => l.data.category);
---

<Base title="Useful links" description="Reference networks, patient organisations and information sources on rare kidney diseases.">
  <PageHeader
    eyebrow="News & Events"
    title="Useful links"
    intro="Reference networks, patient organisations and trusted information on rare and genetic kidney diseases."
    crumbs={[{ label: 'Useful links', href: '/useful-links/' }]}
  />
  <section class="section section--white">
    <div class="container">
      {
        [...groups].map(([category, list]) => (
          <section class="group" aria-labelledby={`g-${category}`} data-reveal>
            <h2 id={`g-${category}`}>{category}</h2>
            <ul role="list">
              {list.map((l) => (
                <li>
                  <a href={l.data.url} rel="noopener" target="_blank">
                    <span class="name">{l.data.name}</span>
                    <span class="desc">{l.data.description}</span>
                    <span class="go" aria-hidden="true">↗</span>
                    <span class="visually-hidden"> (opens in a new tab)</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .group {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: 1rem 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 760px) {
    .group {
      grid-template-columns: 1fr;
    }
  }

  h2 {
    font-size: var(--step-1);
    color: var(--ink);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  a {
    display: grid;
    grid-template-columns: 12rem 1fr auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 1rem 0.5rem;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  @media (max-width: 600px) {
    a {
      grid-template-columns: 1fr auto;
    }

    .desc {
      grid-column: 1;
    }
  }

  a:hover {
    background: var(--paper);
  }

  .name {
    font-weight: 600;
    color: var(--ink);
  }

  .desc {
    color: var(--ink-soft);
  }

  .go {
    color: var(--orange-ink);
    font-weight: 600;
    transition: transform 0.3s var(--ease-out);
  }

  a:hover .go {
    transform: translate(3px, -3px);
  }
</style>
