---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getNews } from '../../lib/content';

const posts = await getNews();
---

<Base title="News" description="News from FEDERG and the rare kidney disease community.">
  <PageHeader eyebrow="News & Events" title="News" intro="What FEDERG and its members have been working on." crumbs={[{ label: 'News', href: '/news/' }]} />
  <section class="section">
    <div class="container">
      <div class="grid grid--3">
        {posts.map((p, i) => <NewsCard post={p} i={i % 3} heading="h2" />)}
      </div>
    </div>
  </section>
</Base>
