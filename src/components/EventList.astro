---
import type { CollectionEntry } from 'astro:content';
import { fmtDate, fmtRange } from '../lib/content';

const isoDate = (d: Date) => d.toISOString().slice(0, 10);

interface Props {
  events: CollectionEntry<'events'>[];
  headingLevel?: 'h2' | 'h3';
  muted?: boolean;
}

const { events, headingLevel: Heading = 'h3', muted = false } = Astro.props;
---

<ul class:list={['events', { 'events--muted': muted }]}>
  {
    events.map((event, i) => (
      <li class="event" data-reveal style={`--i:${i}`}>
        <div class="event__date" aria-hidden="true">
          <span class="event__day">{event.data.start.getUTCDate()}</span>
          <span class="event__month">{fmtDate(event.data.start, { month: 'short' })}</span>
        </div>
        <div class="event__body">
          <Heading class="event__title">
            <a href={`/events/${event.id}/`}>{event.data.title}</a>
          </Heading>
          <p class="event__meta">
            <time datetime={isoDate(event.data.start)}>{fmtRange(event.data.start, event.data.end)}</time>
            <span aria-hidden="true">·</span>
            <span>{event.data.format}</span>
            {event.data.location !== event.data.format && (
              <>
                <span aria-hidden="true">·</span>
                <span>{event.data.location}</span>
              </>
            )}
          </p>
        </div>
        <span class="event__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .event {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 2.4vw, 32px);
    padding: clamp(18px, 2.4vw, 26px) 0;
    border-top: 1px solid var(--line);
  }
  .event:last-child { border-bottom: 1px solid var(--line); }

  .event__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: clamp(64px, 6vw, 80px);
    aspect-ratio: 1;
    border-radius: 18px;
    background: var(--navy);
    color: #fff;
    line-height: 1;
    transition: background 0.3s ease;
  }
  .events--muted .event__date { background: var(--paper); color: var(--ink); }
  .event__day { font-size: clamp(1.5rem, 2.2vw, 1.9rem); font-weight: 700; }
  .event__month {
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .event__title {
    margin: 0 0 6px;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .event__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .event__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .event__title a:focus-visible { outline: none; box-shadow: none; }
  .event:has(a:focus-visible) {
    outline: 3px solid var(--orange);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--navy);
    border-radius: 12px;
  }

  .event__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 0;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .event__arrow {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1.5px solid rgb(var(--navy-rgb) / 30%);
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .event__arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .event:hover .event__date { background: var(--eu-blue); }
  .events--muted .event:hover .event__date { background: #e7e7f0; }
  .event:hover .event__arrow {
    background: var(--orange);
    border-color: var(--orange);
    transform: translateX(4px);
  }

  @media (max-width: 560px) {
    .event { grid-template-columns: auto minmax(0, 1fr); }
    .event__arrow { display: none; }
  }
</style>
