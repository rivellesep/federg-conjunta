---
import { nav } from '../data/nav';

const path = Astro.url.pathname;
const isActive = (href?: string) => (href ? path === href || (href !== '/' && path.startsWith(href)) : false);
const groupActive = (item: (typeof nav)[number]) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<header class="site-header" data-header>
  <div class="site-header__inner container">
    <a class="site-header__logo" href="/" aria-label="FEDERG home">
      <img src="/logo/federg_logo.svg" alt="FEDERG" width="150" height="30" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="visually-hidden">Menu</span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main" data-nav>
      <ul class="site-nav__list">
        {
          nav.map((item, i) =>
            item.children ? (
              <li class="site-nav__item has-sub" data-sub>
                <button
                  class:list={['site-nav__link', { 'is-active': groupActive(item) }]}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`sub-${i}`}
                >
                  {item.label}
                  <svg class="chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </button>
                <ul class="site-nav__sub" id={`sub-${i}`}>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a
                  class:list={['site-nav__link', { 'is-active': isActive(item.href) }]}
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
      <div class="site-nav__tools">
        <a class="icon-btn" href="/search/" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"></circle>
            <path d="m20 20-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </a>
        <a class="btn btn--ghost site-nav__cta" href="/contact/">Join FEDERG</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 50;
    height: var(--header-h);
    background: var(--white);
    border-bottom: 1px solid var(--line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    gap: 1.5rem;
  }

  .site-header__logo {
    flex-shrink: 0;
    display: block;
    padding: 6px 0;
  }

  .site-header__logo img {
    width: 150px;
    height: auto;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item {
    position: relative;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    font-weight: 550;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .site-nav__link:hover,
  .has-sub[data-open] > .site-nav__link {
    background: var(--paper);
  }

  /* Orange underline marks the current section (decoration, not text) */
  .site-nav__link.is-active {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 8px;
  }

  .chev {
    transition: transform 0.25s var(--ease-out);
  }

  .has-sub[data-open] .chev {
    transform: rotate(180deg);
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 16rem;
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--orange);
    border-radius: 14px;
    box-shadow: 0 24px 48px -20px rgb(var(--navy-rgb) / 30%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease-out),
      visibility 0.2s;
  }

  .has-sub[data-open] > .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* Visible at once, so keyboard users can Tab straight into the submenu */
    transition:
      opacity 0.2s,
      transform 0.25s var(--ease-out),
      visibility 0s;
  }

  .site-nav__sub a {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 9px;
    color: var(--ink);
    font-size: 0.97rem;
    text-decoration: none;
  }

  .site-nav__sub a:hover,
  .site-nav__sub a[aria-current='page'] {
    background: var(--orange-soft);
  }

  .site-nav__tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--ink);
  }

  .icon-btn:hover {
    background: var(--paper);
  }

  .site-nav__cta {
    min-height: 46px;
    padding-inline: 1.2rem;
    font-size: 0.95rem;
  }

  .menu-toggle {
    display: none;
  }

  /* Tablets and small laptops: the whole menu still fits if it tightens up */
  @media (min-width: 768px) and (max-width: 1179px) {
    .site-header__inner {
      gap: 0.75rem;
    }

    .site-header__logo img {
      width: 120px;
    }

    .site-nav {
      gap: 0.25rem;
    }

    .site-nav__list {
      gap: 0;
    }

    .site-nav__link {
      padding-inline: 0.6rem;
      font-size: 0.95rem;
    }

    /* "Contact" is already in the menu */
    .site-nav__cta {
      display: none;
    }

    /* The last submenu opens towards the left so it stays on screen */
    .site-nav__item:nth-last-child(2) .site-nav__sub {
      left: auto;
      right: 0;
    }
  }

  /* Phones: hamburger menu */
  @media (max-width: 767px) {
    .menu-toggle {
      position: relative;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 7px;
      background: var(--ink);
      cursor: pointer;
    }

    .menu-toggle__bars,
    .menu-toggle__bars::before,
    .menu-toggle__bars::after {
      display: block;
      width: 18px;
      height: 2px;
      border-radius: 2px;
      background: #fff;
      transition: transform 0.3s var(--ease-out);
    }

    .menu-toggle__bars {
      position: relative;
    }

    .menu-toggle__bars::before,
    .menu-toggle__bars::after {
      content: '';
      position: absolute;
      left: 0;
    }

    .menu-toggle__bars::before {
      top: -6px;
    }

    .menu-toggle__bars::after {
      top: 6px;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
      background: transparent;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
      transform: translateY(6px) rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .site-nav {
      position: fixed;
      inset: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: calc(var(--header-h) + 1rem) var(--gutter) 2rem;
      overflow-y: auto;
      background: var(--white);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition:
        opacity 0.25s,
        transform 0.3s var(--ease-out),
        visibility 0.25s;
    }

    .site-nav[data-open] {
      visibility: visible;
      opacity: 1;
      transform: none;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__item {
      border-bottom: 1px solid var(--line);
    }

    .site-nav__link {
      width: 100%;
      justify-content: space-between;
      min-height: 56px;
      padding: 0.75rem 0;
      font-size: 1.15rem;
      border-radius: 0;
    }

    .site-nav__link:hover,
    .has-sub[data-open] > .site-nav__link {
      background: none;
    }

    .site-nav__link.is-active {
      box-shadow: none;
      color: var(--orange-ink);
    }

    .site-nav__sub {
      position: static;
      display: none;
      min-width: 0;
      padding: 0 0 0.75rem;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .has-sub[data-open] > .site-nav__sub {
      display: block;
    }

    .site-nav__tools {
      justify-content: space-between;
    }
  }

  /* Without JS the menu stays usable as a plain list */
  :global(html:not(.js)) .menu-toggle {
    display: none;
  }

  @media (max-width: 767px) {
    :global(html:not(.js)) .site-header {
      position: static;
      height: auto;
    }

    :global(html:not(.js)) .site-header__inner {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }

    :global(html:not(.js)) .site-nav {
      position: static;
      visibility: visible;
      opacity: 1;
      transform: none;
      width: 100%;
      padding: 0;
    }

    :global(html:not(.js)) .site-nav__sub {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navEl = header?.querySelector<HTMLElement>('[data-nav]');
  const subs = [...(header?.querySelectorAll<HTMLElement>('[data-sub]') ?? [])];
  const desktop = window.matchMedia('(min-width: 768px) and (hover: hover)');

  const setSub = (li: HTMLElement, open: boolean) => {
    li.toggleAttribute('data-open', open);
    li.querySelector('button')?.setAttribute('aria-expanded', String(open));
  };
  const closeAll = (except?: HTMLElement) => subs.forEach((li) => li !== except && setSub(li, false));

  const setMenu = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    navEl?.toggleAttribute('data-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));

  subs.forEach((li) => {
    const btn = li.querySelector('button')!;
    btn.addEventListener('click', () => {
      const open = !li.hasAttribute('data-open');
      closeAll(li);
      setSub(li, open);
    });
    // Hover opening only on desktop pointers; keyboard and touch use the button
    li.addEventListener('pointerenter', (e) => {
      if (desktop.matches && e.pointerType === 'mouse') {
        closeAll(li);
        setSub(li, true);
      }
    });
    li.addEventListener('pointerleave', (e) => {
      if (desktop.matches && e.pointerType === 'mouse') setSub(li, false);
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node)) setSub(li, false);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = subs.find((li) => li.hasAttribute('data-open'));
    if (open) {
      setSub(open, false);
      open.querySelector('button')?.focus();
    } else if (toggle?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      toggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node)) closeAll();
  });
</script>
