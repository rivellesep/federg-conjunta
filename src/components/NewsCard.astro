---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { fmtDate, slugify } from '../lib/content';

interface Props {
  post: CollectionEntry<'news'>;
  i?: number;
  heading?: 'h2' | 'h3';
}
const { post, i = 0, heading: H = 'h3' } = Astro.props;
const { title, date, summary, tags, image, imageAlt } = post.data;
---

<article class="card news-card" data-reveal style={`--i:${i}`}>
  <!-- Astro resizes the image and serves WebP at build time -->
  <Image
    class="news-card__img"
    src={image}
    alt={imageAlt}
    widths={[400, 640, 960]}
    sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 92vw"
    loading="lazy"
  />
  <p class="card__meta"><time datetime={date.toISOString().slice(0, 10)}>{fmtDate(date)}</time></p>
  <H><a class="card__link" href={`/news/${post.id}/`}>{title}</a></H>
  <p>{summary}</p>
  {
    tags.length > 0 && (
      <ul class="tags card__foot" aria-label="Tags">
        {tags.slice(0, 3).map((t) => (
          <li>
            <a class="tag" href={`/tags/${slugify(t)}/`}>{t}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .news-card {
    overflow: hidden;
  }

  /* The image bleeds to the card edges */
  .news-card__img {
    width: calc(100% + 2 * clamp(1.4rem, 1.1rem + 1vw, 2rem));
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin: calc(-1 * clamp(1.4rem, 1.1rem + 1vw, 2rem)) calc(-1 * clamp(1.4rem, 1.1rem + 1vw, 2rem)) 0.4rem;
    border-bottom: 4px solid var(--orange);
  }

  /* Tags stay clickable above the stretched card link */
  .news-card .tags {
    position: relative;
    z-index: 1;
  }
</style>
